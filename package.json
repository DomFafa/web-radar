{
  "name": "web-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:builder": "node scripts/start-site-builder.mjs",
    "dev:test": "node scripts/start-dev.mjs --env test",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/verify_clone_tasks.mjs",
    "types": "wrangler types",
    "check": "npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply web-radar --local"
  },
  "dependencies": {
    "hono": "4.13.7",
    "parse5": "^7.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2",
    "drizzle-orm": "0.45.2",
    "marked": "18.0.5",
    "react-quill-new": "3.8.3",
    "read-excel-file": "9.3.10",
    "@cloudflare/puppeteer": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "undici": "7.29.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
