# Copy to ignored .dev.vars for real-service local configuration.
# Dedicated Web Radar credentials only. Empty values mean unavailable.
ENVIRONMENT=production
TEST_PROVIDERS=false
APP_ORIGIN=
PRODUCT_RADAR_BASE_URL=
PRODUCT_RADAR_PARENT_ORIGINS=
PRODUCT_RADAR_INTEGRATION_SECRET=
TEXT_API_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=gpt-5.5
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
AGNES_API_BASE_URL=
AGNES_API_KEY=
AGNES_MODEL=
AGNES_CONTRACT=
PROVIDER_MEDIA_ORIGINS=
ASSET_SIGNING_KEY=
# Optional secret JSON array: [{"accountId":"account-id","apiToken":"dedicated-token"}]
# When nonempty, this replaces the two legacy fields below. Account IDs must be unique.
# Keep an existing site's bound account configured; rotate its token without changing accountId.
CLOUDFLARE_HOSTING_ACCOUNTS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
