# Web Radar 本地真实服务配置
# 复制为项目根目录的 .dev.vars 后填写；.dev.vars 已被 Git 忽略，请勿提交或分享。
# 等号右边填写实际值，空值表示尚未配置。含空格、# 等字符的值请用引号包住。
# 模型、路径和模式已填好默认值；API 地址、密钥、账号和域名需要自行填写。
#
# 启动方式：npm run build → npm run db:local → npm run dev
# 若 8788 端口已有测试服务，请先停止该服务。npm run dev:test 使用独立测试配置。
# 仅填写本文件不会切换正在运行的测试服务，也不会自动部署到 Cloudflare。

# 1. 运行模式与访问地址
# production 在这里表示调用真实服务；保留以下两行即可。
ENVIRONMENT=production
TEST_PROVIDERS=false
# Web Radar 的外部可访问 HTTPS origin，例如 https://studio.example.com
# 不带结尾斜杠或路径。真实图片/视频引用、媒体链接和发布需要此地址。
# 本地联调可用指向本服务的 HTTPS 隧道地址；不能填仅本机可访问的 127.0.0.1。
APP_ORIGIN=
# 媒体 URL 签名密钥：独立随机字符串，至少 32 个字符，不是供应商 API Key。
# 自动生成的本地 .dev.vars 会填入随机值；请保持稳定，更换会使旧签名链接失效。
ASSET_SIGNING_KEY=

# 2. Product Radar 账号与数据衔接（真实登录需要）
# 服务端地址，只填 origin，不带路径或结尾斜杠，例如 https://radar.example.com
PRODUCT_RADAR_BASE_URL=
# 允许嵌入 Web Radar 的 Product Radar 网页 origin；多个地址用英文逗号分隔。
# 通常与上面的地址相同；不要加路径、结尾斜杠或通配符。
PRODUCT_RADAR_PARENT_ORIGINS=
# 至少 32 个字符，必须与 Product Radar 端的 WEB_RADAR_INTEGRATION_SECRET 完全一致。
# Product Radar 端还需配置 WEB_RADAR_BASE_URL 并实现衔接接口，详见 docs/web-radar-integration-contract.md。
# Web Radar 的独立登录也复用 Product Radar 账号；此处不需要填写 Supabase 密钥。
PRODUCT_RADAR_INTEGRATION_SECRET=

# 3. 文字 / 文案 / 翻译
# OpenAI 兼容接口的基础地址，通常形如 https://api.example.com/v1
# 程序会追加 /chat/completions，不要在这里写完整接口路径。必须使用 HTTPS。
TEXT_API_BASE_URL=https://api.openai.com/v1
# Web Radar 专用 API Key；模型需在该 Key 对应账户中可用。
TEXT_API_KEY=
TEXT_MODEL=gpt-5.5
# 当前代码没有独立的 Word/PDF 文档生成 API，因此没有额外 DOCUMENT_API 字段。

# 4. Image 2.5 页面设计图
# HTTPS 基础地址，通常形如 https://api.example.com/v1
# 程序会追加 /images/edits；供应商必须支持 multipart 多参考图编辑接口。
IMAGE_API_BASE_URL=https://api.openai.com/v1
# 请填为 Web Radar 新建的专用图片 Key，不要复用 Product Radar 的旧 Key。
IMAGE_API_KEY=
# 当前适配器只支持以下模型，保持不变。
IMAGE_MODEL=gpt-image-2.5-sunburst

# screenshot-to-code 独立网站生成服务
# 线上填已部署的 HTTPS 服务地址；本机先运行 npm run dev:builder 验证。
# 不填写第三方 screenshot-to-code 演示站地址，需使用本项目 services/site-builder 服务。
SITE_BUILDER_URL=
# 与 Python 服务的 SITE_BUILDER_KEY 相同；使用独立随机长字符串，不能填写 OpenAI Key。
SITE_BUILDER_KEY=
# 本地启动脚本复用上方 TEXT_API_KEY / TEXT_API_BASE_URL；Python 服务无需再次填写模型密钥。
# 可选环境变量 SITE_BUILDER_MODEL 默认为 gpt-5.5；生产服务须单独配置 OpenAI 环境变量。

# 5. 旧版 Agnes 视频（静态网站流程无需填写，历史任务仍可查询）
# 填供应商提供的 HTTPS 地址；当前适配器只接受域名根路径或 /v1。
# 不要在基础地址里添加 /videos、/agnesapi 或查询参数。
AGNES_API_BASE_URL=https://apihub.agnes-ai.com
AGNES_API_KEY=
# 以下为当前代码支持的模型、契约标记与接口路径，保持不变。
# 填写这些默认值不代表供应商账户权限或真实生成已通过验证。
AGNES_MODEL=agnes-video-v2.0
AGNES_CONTRACT=agnes-video-v2.0-2026-09
AGNES_SUBMIT_PATH=/v1/videos
AGNES_STATUS_PATH=/agnesapi
# 图片/视频结果下载地址的 HTTPS origin 白名单，多个地址用英文逗号分隔。
# 例如 https://images.example.com,https://video-cdn.example.com
# 应填写供应商实际返回的媒体/CDN 域名；它可能与 API 域名不同。
# 不带路径、结尾斜杠或通配符。APP_ORIGIN 会自动加入允许列表。
# 已填 Agnes 官方文档中的输出域名；若实际任务返回不同域名，核实后再添加。
PROVIDER_MEDIA_ORIGINS=https://platform-outputs.agnes-ai.space,https://cos-platform-outputs.agnes-ai.cn

# 6. Cloudflare Pages 网站发布
# 单账号：填写以下两项，CLOUDFLARE_HOSTING_ACCOUNTS 留空即可。
# 填 Cloudflare Account ID，不是 Zone ID；Token 需能管理该账号的 Pages 项目。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 多账号（可选）：填 JSON 数组。非空时会覆盖上面两项，每个 accountId 必须唯一。
# 格式示例：CLOUDFLARE_HOSTING_ACCOUNTS='[{"accountId":"账号ID","apiToken":"专用Token"}]'
# 已发布网站绑定的账号须继续保留；轮换 Token 时不要改变 accountId。
CLOUDFLARE_HOSTING_ACCOUNTS=
# 本地 DB/R2 使用 Wrangler 模拟资源，无需 R2 Access Key / Secret Key。
# 正式部署还需在 wrangler.jsonc 设置真实 D1 database_id 和 R2 bucket_name，
# 并配置部署账号、DB / MEDIA / COORDINATOR 绑定。这些不是本文件可替代的 API 字段。

# 7. Resend 询盘邮件
RESEND_API_KEY=
# 使用 Resend 已验证域名的发信地址，例如 MAIL_FROM='Web Radar <hello@example.com>'
MAIL_FROM=
# 收件人来自网站公司资料中的联系邮箱；当前没有单独的 SMTP 或 MAIL_TO 配置。
